<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- One screen at a time: drives, log, language, updates. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/screen_drives"
            layout="@layout/screen_drives" />

        <include
            android:id="@+id/screen_log"
            layout="@layout/screen_log" />

        <include
            android:id="@+id/screen_language"
            layout="@layout/screen_language" />

        <include
            android:id="@+id/screen_updates"
            layout="@layout/screen_updates" />
    </FrameLayout>

    <!-- Tab bar: platform buttons, no navigation library, Android 5 safe. -->
    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tab_drives"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_drives"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tab_log"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_log"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tab_language"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/language"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tab_updates"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tab_updates"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
